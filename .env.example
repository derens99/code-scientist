# Only needed for --provider anthropic (and --pdf-vision).
# The default deterministic provider and the claude-cli / codex-cli /
# host-agent providers work without any API key.
ANTHROPIC_API_KEY=

# Optional workbench input boundaries. Paths outside the repository require an
# explicit platform-delimiter-separated allowlist. Direct fetches require an
# explicit comma-separated domain allowlist.
CODE_SCIENTIST_ALLOWED_ROOTS=
CODE_SCIENTIST_ALLOWED_FETCH_DOMAINS=
